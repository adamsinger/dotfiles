# Minimal: resume from most recent Codex JSONL session
codex_continue() {
  local latest
  latest=$(find "$HOME/.codex/sessions" -type f -name '*.jsonl' -print0 2>/dev/null | xargs -0 ls -t 2>/dev/null | head -n 1)
  if [ -z "$latest" ]; then
    echo "No session files found in ~/.codex/sessions"
    return 1
  fi
  echo "Resuming from: $latest"
  codex --config experimental_resume="$latest" "$@"
}
